{
  "name": "ecos",
  "version": "0.1.0",
  "private": true,
  "description": "ECOS — Listick Games · Game Jam ANIEI 2026. Exploración y acción 2D con profundidad; conjuros deletreados en LSM.",
  "type": "module",
  "scripts": {
    "setup": "node tools/setup-mediapipe.mjs",
    "predev": "node tools/setup-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node tools/setup-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:nivel2": "node tools/test-nivel-02.mjs",
    "test:nivel3": "node tools/test-nivel-03.mjs",
    "test:nivel4": "node tools/test-nivel-04.mjs",
    "test:nivel6": "node tools/test-nivel-06.mjs",
    "test:nivel7": "node tools/test-nivel-07.mjs && node tools/test-nivel-07-sistemas.mjs",
    "test:nivel10": "node tools/test-nivel-10.mjs",
    "test:mecanicas": "node tools/test-mecanicas.mjs",
    "placeholders": "node tools/gen-placeholders.mjs",
    "scenery:nivel2": "node tools/gen-tuxtla-scenery.mjs",
    "scenery:nivel3": "node tools/gen-catemaco-scenery.mjs",
    "scenery:nivel4": "node tools/gen-oaxaca-scenery.mjs",
    "scenery:nivel6": "node tools/gen-cdmx-scenery.mjs",
    "scenery:nivel7": "node tools/gen-cdmx2-scenery.mjs",
    "scenery:nivel10": "node tools/gen-gdl-scenery.mjs",
    "electron:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "main": "electron/main.cjs",
  "author": "Listick Games",
  "build": {
    "appId": "mx.listickgames.ecos",
    "productName": "ECOS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ECOS-${version}-portable.exe"
    }
  }
}
