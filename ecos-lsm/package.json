{
  "name": "ecos-lsm",
  "version": "1.0.0",
  "private": true,
  "description": "Reconocimiento del alfabeto manual de Lengua de Señas Mexicana (LSM) con la cámara web para ECOS (Listick Games). Sin dependencias de motor de juego.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "setup": "node tools/setup-mediapipe.mjs",
    "predev": "node tools/setup-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node tools/setup-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "phaser": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
